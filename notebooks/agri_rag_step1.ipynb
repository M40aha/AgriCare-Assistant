    "intent_tests_passed": INTENT_TESTS_PASSED,
    "guard_tests_passed": GUARD_TESTS_PASSED,
    "no_rag_errors": smoke_test_df["rag_error"].eq("").all(),
    "no_base_errors": smoke_test_df["base_error"].eq("").all(),
