## 5. Build or reuse the two Chroma collections
def corpus_hash(frame, model_name):
    # Include both text and retrieval metadata. A metadata-only change must also
    # trigger rebuilding, even when the chunk count and text stay unchanged.
    ordered = frame.sort_values("chunk_id").copy()

    hash_columns = [
        "chunk_id",
        "chunk_text",
        "item_type",
        "section",
        "product_id",
        "product_name_en",
        "product_type_en",
        "primary_category_en",
        "secondary_category_en",
        "source_type",
        "source_file",
        "conversation_id",
        "chat_category",
        "intent",
        "requires_product_name",
        "safety_flag",
        "version",
    ]

    available_columns = [
        column for column in hash_columns
        if column in ordered.columns
    ]

    records = ordered[available_columns].astype(str).to_dict(
        orient="records"
    )
    payload = json.dumps(
        records,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )

    return hashlib.sha256(
        f"{model_name}\n{payload}".encode("utf-8")
    ).hexdigest()

def build_or_reuse_collection(
    chroma_client,
    collection_name,
    frame,
    embedding_function,
    source_description,
):
    expected_hash = corpus_hash(frame, EMBEDDING_MODEL)
    existing_names = {c.name for c in chroma_client.list_collections()}

    if collection_name in existing_names and not REBUILD_COLLECTIONS:
        collection = chroma_client.get_collection(
            name=collection_name,
            embedding_function=embedding_function,
        )
        metadata = collection.metadata or {}

        valid = (
            metadata.get("corpus_hash") == expected_hash
            and metadata.get("embedding_model") == EMBEDDING_MODEL
            and collection.count() == len(frame)
        )

        if valid:
            print(
                f"Reusing {collection_name}: "
                f"{collection.count()} documents."
            )
            return collection, expected_hash, False

        print(f"{collection_name} is stale and will be rebuilt.")

    if collection_name in existing_names:
        chroma_client.delete_collection(collection_name)
        print("Deleted:", collection_name)

    collection = chroma_client.get_or_create_collection(
        name=collection_name,
        embedding_function=embedding_function,
        metadata={
            "description": source_description,
            "embedding_model": EMBEDDING_MODEL,
            "corpus_hash": expected_hash,
            "document_count": len(frame),
            "hnsw:space": "cosine",
        },
    )

    ids = frame["chunk_id"].astype(str).tolist()
    documents = frame["chunk_text"].astype(str).tolist()
    metadatas = frame["chroma_metadata"].tolist()

    for start in range(0, len(ids), EMBED_BATCH_SIZE):
        end = min(start + EMBED_BATCH_SIZE, len(ids))
        collection.upsert(
            ids=ids[start:end],
            documents=documents[start:end],
            metadatas=metadatas[start:end],
        )
        print(f"{collection_name}: {end}/{len(ids)}")

    if collection.count() != len(frame):
        raise ValueError(
            f"{collection_name} count mismatch: "
            f"{collection.count()} != {len(frame)}"
        )

    return collection, expected_hash, True

