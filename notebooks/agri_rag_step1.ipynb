def detect_intents(question):
    q = str(question).lower().strip()

    return [
        intent
        for intent, patterns in INTENT_PATTERNS.items()
        if any(pattern in q for pattern in patterns)
    ]


PRODUCT_USAGE_PATTERNS = [
    r"\bhow\s+(?:do|should|can)\s+i\s+(?:use|apply|spray)\b",
    r"\bhow\s+to\s+(?:use|apply|spray)\b",
    r"\bapplication\s+method\b",
    r"\bwhen\s+should\s+i\s+(?:use|apply|spray)\b",
    r"\bhow\s+often\s+should\s+i\s+(?:use|apply|spray)\b",
    r"\bwhere\s+should\s+i\s+(?:use|apply|spray)\b",
]


CROP_COMPATIBILITY_PATTERNS = [
    r"\bcan\s+i\s+(?:use|apply|spray)\b.*\b(?:on|to)\b",
    r"\bcan\s+(?:this|the)\s+product\s+be\s+used\b",
    r"\bbe\s+used\s+on\b",
    r"\buse\s+(?:this|the)\s+product\s+on\b",
    r"\bsuitable\s+for\b",
    r"\bcompatible\s+with\b",
    r"\bapproved\s+for\b",
]


HIGH_PRIORITY_INTENTS = [
    "safety",
    "after_sales",
    "authenticity",
    "diagnosis",
    "product_recommendation",
    "dosage",
    "ingredient",
]


def classify_intent(question):
    q = str(question).lower().strip()
    detected = detect_intents(q)

    # These intents have priority over usage and crop wording.
    for intent in HIGH_PRIORITY_INTENTS:
        if intent in detected:
            return intent

    # Example: "How do I apply Cucumber Bacteria Clear?"
    if any(
        re.search(pattern, q)
        for pattern in PRODUCT_USAGE_PATTERNS
    ):
        return "product_usage"

    # Example: "Can this product be used on tomatoes?"
    if any(
        re.search(pattern, q)
        for pattern in CROP_COMPATIBILITY_PATTERNS
    ):
        return "crop_compatibility"

    if "crop_compatibility" in detected:
        return "crop_compatibility"

    if "product_usage" in detected:
        return "product_usage"

    return "unknown"


