def choose_route(
    question,
    primary_intent,
    detected,
    mentions,
):
    """
    Select the catalog and/or chat sources that should be searched.

    Diagnosis questions use the dedicated diagnosis conversations.
    The general chat fallback is not used for generic diagnosis questions.
    """

    targets = []

    # Apply an exact product filter when exactly one product was detected.
    product_filter = None

    if len(mentions) == 1:
        product_filter = {
            "product_name_en": (
                mentions[0]["product_name_en"]
            )
        }

    def add_catalog(priority=1.0):
        targets.append({
            "collection_key": "catalog",
            "source_label": "catalog",
            "where": product_filter,
            "priority": priority,
        })

    def add_chat(
        category=None,
        priority=1.0,
    ):
        if category:
            source_label = f"chat:{category}"
            where_filter = {
                "chat_category": category
            }
        else:
            source_label = "chat"
            where_filter = None

        targets.append({
            "collection_key": "chat",
            "source_label": source_label,
            "where": where_filter,
            "priority": priority,
        })

    # ----------------------------------------------------------
    # Safety
    # Search the catalog, safety conversations, and then all chats
    # as a lower-priority fallback.
    # ----------------------------------------------------------
    if "safety" in detected:
        add_catalog(priority=1.0)

        add_chat(
            category="safety_sensitive",
            priority=1.0,
        )

        add_chat(
            category=None,
            priority=0.55,
        )

    # ----------------------------------------------------------
    # After-sales and logistics
    # ----------------------------------------------------------
    if "after_sales" in detected:
        add_chat(
            category="aftersales_logistics",
            priority=1.0,
        )

        add_chat(
            category=None,
            priority=0.60,
        )

    # ----------------------------------------------------------
    # Product authenticity
    # Authenticity conversations can appear in more than one
    # original chat category, so search all chats.
    # ----------------------------------------------------------
    if "authenticity" in detected:
        add_chat(
            category=None,
            priority=1.0,
        )

        add_catalog(priority=0.70)

    # ----------------------------------------------------------
    # Diagnosis
    # Generic symptom questions use only dedicated diagnosis chats.
    # Catalog retrieval is added only when a product was named.
    # ----------------------------------------------------------
    if "diagnosis" in detected:
        add_chat(
            category="diagnosis",
            priority=1.0,
        )

        if mentions:
            add_catalog(priority=0.60)

    # ----------------------------------------------------------
    # Product recommendation
    # ----------------------------------------------------------
    if "product_recommendation" in detected:
        add_catalog(priority=1.0)

        add_chat(
            category="usage_product",
            priority=0.85,
        )

        add_chat(
            category=None,
            priority=0.50,
        )

    # ----------------------------------------------------------
    # Product usage
    # ----------------------------------------------------------
    if "product_usage" in detected:
        add_catalog(priority=1.0)

        add_chat(
            category="usage_product",
            priority=1.0,
        )

        add_chat(
            category=None,
            priority=0.55,
        )

    # ----------------------------------------------------------
    # Catalog-focused intents
    # ----------------------------------------------------------
    catalog_intents = {
        "dosage",
        "ingredient",
        "crop_compatibility",
    }

    if any(
        intent in detected
        for intent in catalog_intents
    ):
        add_catalog(priority=1.0)

    # ----------------------------------------------------------
    # Unknown intent fallback
    # ----------------------------------------------------------
    if not targets:
        add_catalog(priority=1.0)

        add_chat(
            category=None,
            priority=0.80,
        )

    # ----------------------------------------------------------
    # Remove duplicate route targets
    # ----------------------------------------------------------
    unique_targets = []
    seen_targets = set()

    for target in targets:
        target_key = (
            target["collection_key"],
            json.dumps(
                target.get("where"),
                sort_keys=True,
            ),
        )

        if target_key not in seen_targets:
            unique_targets.append(target)
            seen_targets.add(target_key)

    # ----------------------------------------------------------
    # Collect preferred catalog sections for reranking
    # ----------------------------------------------------------
    preferred_sections = sorted({
        section
        for intent in detected
        for section in PREFERRED_SECTIONS.get(
            intent,
            [],
        )
    })

    # ----------------------------------------------------------
    # Collect preferred chat intents for reranking
    # ----------------------------------------------------------
    preferred_chat_intents = sorted({
        chat_intent
        for intent in detected
        for chat_intent in PREFERRED_CHAT_INTENTS.get(
            intent,
            [],
        )
    })

    return {
        "primary_intent": primary_intent,
        "detected_intents": detected,
        "targets": unique_targets,
        "final_top_k": TOP_K.get(
            primary_intent,
            TOP_K["unknown"],
        ),
        "preferred_sections": preferred_sections,
        "preferred_chat_intents": (
            preferred_chat_intents
        ),
    }


print("Routing rules ready.")
## 9. Routed retrieval and reranking
COLLECTIONS = {
    "catalog": catalog_collection,
    "chat": chat_collection,
}


def query_target(
    target,
    question,
    n_results,
):
    """
    Query one routed Chroma collection.

    Returns:
        rows: retrieved candidate records
        error: error message or None
    """
    collection = COLLECTIONS[
        target["collection_key"]
    ]

    if collection.count() == 0:
        return [], (
            f"{target['collection_key']} collection is empty."
        )

    kwargs = {
        "query_texts": [question],
        "n_results": min(
            n_results,
            collection.count(),
        ),
        "include": [
            "documents",
            "metadatas",
            "distances",
        ],
    }

    if target.get("where"):
        kwargs["where"] = target["where"]

    try:
        raw = collection.query(**kwargs)

    except Exception as exc:
        return [], (
            f"{target['source_label']}: {exc}"
        )

    ids = raw.get("ids", [[]])[0]
    documents = raw.get("documents", [[]])[0]
    metadatas = raw.get("metadatas", [[]])[0]
    distances = raw.get("distances", [[]])[0]

    rows = []

    for (
        chunk_id,
        document,
        metadata,
        distance,
    ) in zip(
        ids,
        documents,
        metadatas,
        distances,
    ):
        rows.append({
            "id": chunk_id,
            "document": document,
            "metadata": metadata or {},
            "distance": float(distance),
            "route_source": target["source_label"],
            "route_priority": float(
                target["priority"]
            ),
        })

    return rows, None


def rerank_candidates(
    candidates,
    route,
    mentions,
):
    """
    Rerank candidates using semantic similarity plus metadata boosts.

    Important improvement:
    only the highest-scoring chunk from each catalog item or chat FAQ
    is retained. This prevents one long FAQ from occupying multiple
    final retrieval positions.
    """
    preferred_sections = set(
        route["preferred_sections"]
    )

    preferred_chat_intents = set(
        route["preferred_chat_intents"]
    )

    mentioned_names = {
        mention["product_name_en"]
        for mention in mentions
    }

    scored = []

    for row in candidates:
        metadata = row.get(
            "metadata",
            {},
        )

        distance = max(
            float(row.get("distance", 0.0)),
            0.0,
        )

        # Smaller Chroma distance means stronger similarity.
        semantic_score = (
            1.0 / (1.0 + distance)
        )

        section_boost = (
            0.14
            if metadata.get("section", "")
            in preferred_sections
            else 0.0
        )

        chat_intent_boost = (
            0.12
            if metadata.get("intent", "")
            in preferred_chat_intents
            else 0.0
        )

        route_priority_boost = (
            0.08
            * float(
                row.get(
                    "route_priority",
                    1.0,
                )
            )
        )

        product_boost = (
            0.18
            if (
                mentioned_names
                and metadata.get(
                    "product_name_en",
                    "",
                )
                in mentioned_names
            )
            else 0.0
        )

        rerank_score = (
            semantic_score
            + section_boost
            + chat_intent_boost
            + route_priority_boost
            + product_boost
        )

        enriched = dict(row)

        enriched.update({
            "semantic_score": semantic_score,
            "section_boost": section_boost,
            "chat_intent_boost": (
                chat_intent_boost
            ),
            "route_priority_boost": (
                route_priority_boost
            ),
            "product_boost": product_boost,
            "rerank_score": rerank_score,
        })

        scored.append(enriched)

    # ----------------------------------------------------------
    # Deduplicate by item_id rather than chunk_id.
    #
    # A long catalog section or FAQ may produce multiple chunks.
    # Keep only the best chunk from each item.
    # ----------------------------------------------------------
    best_by_item = {}

    for row in scored:
        metadata = row.get(
            "metadata",
            {},
        )

        source_type = str(
            metadata.get(
                "source_type",
                "",
            )
        ).strip()

        item_id = str(
            metadata.get(
                "item_id",
                "",
            )
        ).strip()

        chunk_id = str(
            row.get(
                "id",
                "",
            )
        ).strip()

        if item_id:
            dedup_key = (
                f"{source_type}::{item_id}"
            )
        else:
            dedup_key = (
                f"{source_type}::{chunk_id}"
            )

        current = best_by_item.get(
            dedup_key
        )

        if (
            current is None
            or row["rerank_score"]
            > current["rerank_score"]
        ):
            best_by_item[
                dedup_key
            ] = row

    result = list(
        best_by_item.values()
    )

    result.sort(
        key=lambda row: (
            -row["rerank_score"],
            row["distance"],
        )
    )

    return result[
        :route["final_top_k"]
    ]


def retrieve_context(question):
    """
    Detect intent, apply clarification rules, route retrieval,
    merge candidates, rerank, and return diagnostics.
    """
    question = str(question).strip()

    if not question:
        raise ValueError(
            "Question cannot be empty."
        )

    retrieval_start = (
        time.perf_counter()
    )

    detected = detect_intents(
        question
    )

    primary = classify_intent(
        question
    )

    mentions = find_product_mentions(
        question
    )

    (
        needs_clarification,
        clarification_message,
    ) = clarification_needed(
        question,
        primary,
        mentions,
    )

    route = choose_route(
        question,
        primary,
        detected,
        mentions,
    )

    if needs_clarification:
        return {
            "question": question,
            "intent": primary,
            "detected_intents": detected,
            "product_mentions": mentions,
            "route": route,
            "needs_clarification": True,
            "clarification_message": (
                clarification_message
            ),
            "chunks": [],
            "retrieval_errors": [],
            "retrieval_latency_ms": round(
                (
                    time.perf_counter()
                    - retrieval_start
                )
                * 1000,
                2,
            ),
            "low_confidence": False,
        }

    candidates = []
    errors = []

    for target in route["targets"]:
        rows, error = query_target(
            target=target,
            question=question,
            n_results=CANDIDATES_PER_ROUTE,
        )

        candidates.extend(rows)

        if error:
            errors.append(error)

    chunks = rerank_candidates(
        candidates=candidates,
        route=route,
        mentions=mentions,
    )

    top_semantic_score = (
        chunks[0]["semantic_score"]
        if chunks
        else 0.0
    )

    retrieval_latency_ms = round(
        (
            time.perf_counter()
            - retrieval_start
        )
        * 1000,
        2,
    )

    return {
        "question": question,
        "intent": primary,
        "detected_intents": detected,
        "product_mentions": mentions,
        "route": route,
        "needs_clarification": False,
        "clarification_message": "",
        "chunks": chunks,
        "retrieval_errors": errors,
        "retrieval_latency_ms": (
            retrieval_latency_ms
        ),
        "low_confidence": bool(
            chunks
            and top_semantic_score < 0.45
        ),
    }


