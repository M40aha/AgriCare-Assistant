## 3. Clean chunks and prepare metadata
def to_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"true", "1", "yes", "y", "t"}

def clean_meta(value):
    if value is None:
        return ""
    if isinstance(value, float) and math.isnan(value):
        return ""
    if isinstance(value, (str, int, float, bool)):
        return value
    return str(value)

META_COLUMNS = [
    "chunk_id", "item_id", "item_type", "section",
    "product_id", "product_name_en", "product_type_en",
    "primary_category_en", "secondary_category_en",
    "source_type", "source_file", "conversation_id",
    "chat_category", "intent", "requires_product_name",
    "status", "review_status", "safety_flag",
    "safety_reviewed", "version",
]

def prepare_chunks(frame, name):
    result = frame.copy()

    for col in META_COLUMNS:
        if col not in result.columns:
            result[col] = ""

    result["chunk_text"] = result["chunk_text"].astype(str).str.strip()
    result["word_count"] = pd.to_numeric(
        result["word_count"], errors="coerce"
    ).fillna(0).astype(int)

    for col in ["safety_flag", "safety_reviewed", "requires_product_name"]:
        result[col] = result[col].apply(to_bool)

    result["version"] = pd.to_numeric(
        result["version"], errors="coerce"
    ).fillna(1).astype(int)

    before = len(result)
    result = result[
        result["chunk_text"].ne("")
        & result["word_count"].ge(MIN_CHUNK_WORDS)
        & result["status"].astype(str).str.lower().eq("active")
    ].copy()

    result = result.drop_duplicates("chunk_id").reset_index(drop=True)

    result["chroma_metadata"] = result.apply(
        lambda row: {
            col: clean_meta(row.get(col, ""))
            for col in META_COLUMNS
        },
        axis=1,
    )

    print(f"{name}: kept {len(result)} of {before} chunks.")

    if result.empty:
        raise ValueError(f"{name} has no usable chunks.")

    return result

