            "needs_clarification", False
        ),
        "low_confidence": rag.get("low_confidence", False),
        "retrieval_latency_ms": rag.get(
            "retrieval_latency_ms", 0.0
        ),
        "rag_generation_latency_ms": rag.get(
            "generation_latency_ms", 0.0
        ),
        "rag_total_latency_ms": rag.get(
            "total_latency_ms", 0.0
        ),
        "base_generation_latency_ms": base.get(
            "generation_latency_ms", 0.0
        ),
        "base_total_latency_ms": base.get(
            "total_latency_ms", 0.0
        ),
        "rag_answer": rag.get("answer", ""),
        "base_answer": base.get("answer", ""),
        "rag_sources": json.dumps(
            sources, ensure_ascii=False
        ),
        "retrieval_errors": json.dumps(
            rag.get("retrieval_errors", []),
            ensure_ascii=False,
        ),
        "rag_error": rag_error,
        "base_error": base_error,
        "timestamp": datetime.now().isoformat(),
    })

    for source in sources:
        debug_rows.append({
            "q_number": q_number,
            "question": question,
            "intent": rag.get("intent", ""),
            **source,
        })

smoke_test_df = pd.DataFrame(smoke_rows)
retrieval_debug_df = pd.DataFrame(debug_rows)

print("Completed:", len(smoke_test_df))
