## 10. Context formatting and source extraction
def format_context(chunks):
    blocks = []

    for i, chunk in enumerate(chunks, start=1):
        meta = chunk["metadata"]
        lines = [
            f"[Source {i}]",
            f"Source Type: {meta.get('source_type', '')}",
            f"Source File: {meta.get('source_file', '')}",
            f"Chunk ID: {meta.get('chunk_id', chunk['id'])}",
        ]

        if meta.get("source_type") == "company_product_catalog":
            lines.extend([
                f"Product Name: {meta.get('product_name_en', '')}",
                f"Product ID: {meta.get('product_id', '')}",
                f"Section: {meta.get('section', '')}",
                f"Product Type: {meta.get('product_type_en', '')}",
            ])
        else:
            lines.extend([
                f"Chat Category: {meta.get('chat_category', '')}",
                f"Intent: {meta.get('intent', '')}",
                f"Conversation ID: {meta.get('conversation_id', '')}",
                f"Related Product: {meta.get('product_name_en', '')}",
            ])

        lines.extend(["", "Content:", chunk["document"]])
        blocks.append("\n".join(lines))

    return "\n\n---\n\n".join(blocks)

def extract_sources(chunks):
    sources = []

    for i, chunk in enumerate(chunks, start=1):
        meta = chunk["metadata"]
        sources.append({
            "source_number": i,
            "source_type": meta.get("source_type", ""),
            "source_file": meta.get("source_file", ""),
            "chunk_id": meta.get("chunk_id", chunk["id"]),
            "item_id": meta.get("item_id", ""),
            "product_name": meta.get("product_name_en", ""),
            "product_id": meta.get("product_id", ""),
            "section": meta.get("section", ""),
            "chat_category": meta.get("chat_category", ""),
            "chat_intent": meta.get("intent", ""),
            "conversation_id": meta.get("conversation_id", ""),
            "distance": round(float(chunk["distance"]), 4),
            "semantic_score": round(float(chunk["semantic_score"]), 4),
            "rerank_score": round(float(chunk["rerank_score"]), 4),
            "route_source": chunk["route_source"],
        })

    return sources
## 11. RAG and baseline prompts
RAG_SYSTEM_PROMPT = """
You are an agriculture product and customer-support assistant.

The context comes from two trusted company sources:
1. The official product catalog.
2. Company-provided employee support conversations.

Rules:
1. Use only the supplied company context for factual claims.
2. Cite every factual claim using `(Source N)`.
3. For dosage, ingredients, crop compatibility, specifications, and
   product safety, prefer the official catalog if sources conflict.
4. For shipping, returns, refunds, tracking, payment, and support procedures,
   prefer the company support-conversation source.
5. Do not invent dosage, ratios, crop approvals, ingredients, safety intervals,
   company policies, authenticity methods, or diagnoses.
6. If context is insufficient, say so and ask for the missing detail.
7. Add a brief label-safety caution for safety-sensitive questions.
8. Do not mention vector distances or internal implementation.
9. Answer in English and be concise.
""".strip()

BASELINE_SYSTEM_PROMPT = """
You are an agriculture product and customer-support assistant without access to
the company's catalog or support records.

Rules:
1. Do not invent company policies, exact dosage, crop approvals, ingredients,
   safety intervals, or authenticity procedures.
2. Ask for missing product, label, order, or context details when necessary.
3. Separate general guidance from company-specific facts.
4. Add a brief caution for pesticide, dosage, toxicity, and harvest questions.
5. Answer in English and be concise.
""".strip()
## 12. RAG and baseline functions
def response_usage(response):
    usage = getattr(response, "usage", None)
    if usage is None:
        return {}
    if hasattr(usage, "model_dump"):
        return usage.model_dump()
    return {"raw": str(usage)}

def ask_rag(question, show_context=False):
    total_start = time.perf_counter()
    retrieved = retrieve_context(question)

    if retrieved["needs_clarification"]:
        return {
            "question": question,
            "intent": retrieved["intent"],
            "detected_intents": retrieved["detected_intents"],
            "route": retrieved["route"],
            "answer": retrieved["clarification_message"],
            "sources": [],
            "needs_clarification": True,
            "retrieval_latency_ms": retrieved["retrieval_latency_ms"],
            "generation_latency_ms": 0.0,
            "total_latency_ms": round(
                (time.perf_counter() - total_start) * 1000, 2
            ),
            "low_confidence": False,
            "retrieval_errors": retrieved["retrieval_errors"],
            "usage": {},
        }

    if not retrieved["chunks"]:
        return {
            "question": question,
            "intent": retrieved["intent"],
            "detected_intents": retrieved["detected_intents"],
            "route": retrieved["route"],
            "answer": (
                "The company knowledge base does not provide enough "
                "information to answer this question."
            ),
            "sources": [],
            "needs_clarification": False,
            "retrieval_latency_ms": retrieved["retrieval_latency_ms"],
            "generation_latency_ms": 0.0,
            "total_latency_ms": round(
                (time.perf_counter() - total_start) * 1000, 2
            ),
            "low_confidence": True,
            "retrieval_errors": retrieved["retrieval_errors"],
            "usage": {},
        }

    context_text = format_context(retrieved["chunks"])
    sources = extract_sources(retrieved["chunks"])

    user_prompt = f"""
Question:
{question}

Primary intent:
{retrieved['intent']}

Detected intents:
{retrieved['detected_intents']}

Retrieved company context:
{context_text}

Answer only from the context and cite factual claims using `(Source N)`.
""".strip()

    generation_start = time.perf_counter()
    response = client.responses.create(
        model=ANSWER_MODEL,
        input=[
            {"role": "system", "content": RAG_SYSTEM_PROMPT},
            {"role": "user", "content": user_prompt},
        ],
    )
    generation_ms = round(
        (time.perf_counter() - generation_start) * 1000, 2
    )

    result = {
        "question": question,
        "intent": retrieved["intent"],
        "detected_intents": retrieved["detected_intents"],
        "route": retrieved["route"],
        "answer": response.output_text,
        "sources": sources,
        "needs_clarification": False,
        "retrieval_latency_ms": retrieved["retrieval_latency_ms"],
        "generation_latency_ms": generation_ms,
        "total_latency_ms": round(
            (time.perf_counter() - total_start) * 1000, 2
        ),
        "low_confidence": retrieved["low_confidence"],
        "retrieval_errors": retrieved["retrieval_errors"],
        "usage": response_usage(response),
    }

    if show_context:
        result["retrieved_context"] = context_text
        result["retrieved_chunks"] = retrieved["chunks"]

    return result

def ask_base_llm(question, apply_shared_guard=True):
    total_start = time.perf_counter()
    intent = classify_intent(question)
    mentions = find_product_mentions(question)
    guard, message = clarification_needed(question, intent, mentions)

    if apply_shared_guard and guard:
        return {
            "question": question,
            "intent": intent,
            "answer": message,
            "needs_clarification": True,
            "generation_latency_ms": 0.0,
            "total_latency_ms": round(
                (time.perf_counter() - total_start) * 1000, 2
            ),
            "usage": {},
        }

    generation_start = time.perf_counter()
    response = client.responses.create(
        model=ANSWER_MODEL,
        input=[
            {"role": "system", "content": BASELINE_SYSTEM_PROMPT},
            {"role": "user", "content": str(question)},
        ],
    )
    generation_ms = round(
        (time.perf_counter() - generation_start) * 1000, 2
    )

    return {
        "question": question,
        "intent": intent,
        "answer": response.output_text,
        "needs_clarification": False,
        "generation_latency_ms": generation_ms,
        "total_latency_ms": round(
            (time.perf_counter() - total_start) * 1000, 2
        ),
        "usage": response_usage(response),
    }

